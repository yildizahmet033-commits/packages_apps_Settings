diff --git a/src/org/evolution/settings/display/resolution/DisplayResolutionPreferenceController.java b/src/org/evolution/settings/display/resolution/DisplayResolutionPreferenceController.java
new file mode 100644
index 00000000000..5001c746e09
--- /dev/null
+++ b/src/org/evolution/settings/display/resolution/DisplayResolutionPreferenceController.java
@@ -0,0 +1,125 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Ahmet033
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.evolution.settings.display.resolution;
+
+import android.content.Context;
+import android.graphics.Point;
+import android.os.RemoteException;
+import android.os.UserHandle;
+import android.util.Log;
+import android.view.Display;
+import android.view.IWindowManager;
+import android.view.WindowManagerGlobal;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+import com.android.settingslib.utils.ThreadUtils;
+
+/** Switches between FHD+ and WQHD+ rendering on panels exposing a single WQHD+ resolution. */
+public class DisplayResolutionPreferenceController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener {
+
+    private static final String TAG = "DisplayResolution";
+
+    private static final int FHD_WIDTH = 1080;
+    private static final int WQHD_WIDTH = 1440;
+
+    private final IWindowManager mWm = WindowManagerGlobal.getWindowManagerService();
+
+    public DisplayResolutionPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        final Point size = getInitialSize();
+        return size != null && size.x == WQHD_WIDTH ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        final ListPreference preference = screen.findPreference(getPreferenceKey());
+        final Point size = getInitialSize();
+        if (preference == null || size == null) return;
+        preference.setEntries(new CharSequence[] {
+                mContext.getString(R.string.display_resolution_fhd,
+                        FHD_WIDTH, heightFor(size, FHD_WIDTH)),
+                mContext.getString(R.string.display_resolution_wqhd, size.x, size.y)});
+        preference.setEntryValues(new CharSequence[] {
+                String.valueOf(FHD_WIDTH), String.valueOf(WQHD_WIDTH)});
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        super.updateState(preference);
+        final ListPreference list = (ListPreference) preference;
+        final Point current = getCurrentSize();
+        if (current == null) return;
+        list.setValue(String.valueOf(current.x));
+        list.setSummary(list.getEntry());
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        final int width = Integer.parseInt((String) newValue);
+        ThreadUtils.postOnBackgroundThread(() -> applyWidth(width));
+        return true;
+    }
+
+    private void applyWidth(int width) {
+        final Point initial = getInitialSize();
+        final Point current = getCurrentSize();
+        if (initial == null || current == null || current.x == width) return;
+        try {
+            final int userId = UserHandle.myUserId();
+            // Scale the current density so that the user's display size choice is kept
+            final int density = Math.round(
+                    mWm.getBaseDisplayDensity(Display.DEFAULT_DISPLAY) * (float) width / current.x);
+            if (width == initial.x) {
+                mWm.clearForcedDisplaySize(Display.DEFAULT_DISPLAY);
+            } else {
+                mWm.setForcedDisplaySize(Display.DEFAULT_DISPLAY, width, heightFor(initial, width));
+            }
+            if (width == initial.x
+                    && density == mWm.getInitialDisplayDensity(Display.DEFAULT_DISPLAY)) {
+                mWm.clearForcedDisplayDensityForUser(Display.DEFAULT_DISPLAY, userId);
+            } else {
+                mWm.setForcedDisplayDensityForUser(Display.DEFAULT_DISPLAY, density, userId);
+            }
+        } catch (RemoteException | SecurityException e) {
+            Log.e(TAG, "Failed to change resolution", e);
+        }
+    }
+
+    private static int heightFor(Point size, int width) {
+        return Math.round(size.y * (float) width / size.x);
+    }
+
+    private Point getInitialSize() {
+        try {
+            final Point size = new Point();
+            mWm.getInitialDisplaySize(Display.DEFAULT_DISPLAY, size);
+            return size;
+        } catch (RemoteException e) {
+            return null;
+        }
+    }
+
+    private Point getCurrentSize() {
+        try {
+            final Point size = new Point();
+            mWm.getBaseDisplaySize(Display.DEFAULT_DISPLAY, size);
+            return size;
+        } catch (RemoteException e) {
+            return null;
+        }
+    }
+}
diff --git a/src/org/evolution/settings/display/saturation/ScreenSaturation.java b/src/org/evolution/settings/display/saturation/ScreenSaturation.java
new file mode 100644
index 00000000000..11f4f05e948
--- /dev/null
+++ b/src/org/evolution/settings/display/saturation/ScreenSaturation.java
@@ -0,0 +1,67 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Ahmet033
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.evolution.settings.display.saturation;
+
+import android.content.Context;
+import android.os.IBinder;
+import android.os.Parcel;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.util.Log;
+
+/** Stores the global screen saturation and applies it through SurfaceFlinger. */
+public final class ScreenSaturation {
+
+    private static final String TAG = "ScreenSaturation";
+
+    /** Saturation in percent, 100 is neutral. */
+    private static final String KEY = "screen_saturation_percent";
+    private static final int MIN = 100;
+    private static final int MAX = 200;
+    private static final int DEFAULT = 200;
+
+    private static final String SURFACE_COMPOSER_INTERFACE = "android.ui.ISurfaceComposer";
+    private static final int TRANSACTION_SATURATION = 1022;
+
+    private ScreenSaturation() {}
+
+    public static int get(Context context) {
+        return clamp(Settings.Secure.getIntForUser(context.getContentResolver(), KEY, DEFAULT,
+                UserHandle.USER_CURRENT));
+    }
+
+    public static void set(Context context, int percent) {
+        Settings.Secure.putIntForUser(context.getContentResolver(), KEY, clamp(percent),
+                UserHandle.USER_CURRENT);
+        apply(percent);
+    }
+
+    /** Re-applies the stored value. */
+    public static void restore(Context context) {
+        apply(get(context));
+    }
+
+    private static void apply(int percent) {
+        final IBinder flinger = ServiceManager.getService("SurfaceFlinger");
+        if (flinger == null) return;
+        final Parcel data = Parcel.obtain();
+        try {
+            data.writeInterfaceToken(SURFACE_COMPOSER_INTERFACE);
+            data.writeFloat(clamp(percent) / 100f);
+            flinger.transact(TRANSACTION_SATURATION, data, null, 0);
+        } catch (RemoteException | SecurityException e) {
+            Log.e(TAG, "Failed to apply saturation", e);
+        } finally {
+            data.recycle();
+        }
+    }
+
+    private static int clamp(int percent) {
+        return Math.max(MIN, Math.min(MAX, percent));
+    }
+}
diff --git a/src/org/evolution/settings/display/saturation/ScreenSaturationPreferenceController.java b/src/org/evolution/settings/display/saturation/ScreenSaturationPreferenceController.java
new file mode 100644
index 00000000000..a4a4bccb0d4
--- /dev/null
+++ b/src/org/evolution/settings/display/saturation/ScreenSaturationPreferenceController.java
@@ -0,0 +1,41 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Ahmet033
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.evolution.settings.display.saturation;
+
+import android.content.Context;
+
+import androidx.preference.Preference;
+
+import com.android.settings.core.BasePreferenceController;
+
+import org.evolution.settings.preferences.CustomSeekBarPreference;
+
+public class ScreenSaturationPreferenceController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener {
+
+    public ScreenSaturationPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        super.updateState(preference);
+        ((CustomSeekBarPreference) preference).setValue(ScreenSaturation.get(mContext));
+        // Changing the color mode resets the saturation, restore it when coming back
+        ScreenSaturation.restore(mContext);
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        ScreenSaturation.set(mContext, (Integer) newValue);
+        return true;
+    }
+}
diff --git a/src/org/evolution/settings/display/saturation/ScreenSaturationReceiver.java b/src/org/evolution/settings/display/saturation/ScreenSaturationReceiver.java
new file mode 100644
index 00000000000..a86007a25dc
--- /dev/null
+++ b/src/org/evolution/settings/display/saturation/ScreenSaturationReceiver.java
@@ -0,0 +1,23 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Ahmet033
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.evolution.settings.display.saturation;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+
+/** The framework resets the saturation to 1.0 on boot, so put the stored value back. */
+public class ScreenSaturationReceiver extends BroadcastReceiver {
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        final String action = intent.getAction();
+        if (Intent.ACTION_LOCKED_BOOT_COMPLETED.equals(action)
+                || Intent.ACTION_BOOT_COMPLETED.equals(action)) {
+            ScreenSaturation.restore(context);
+        }
+    }
+}
