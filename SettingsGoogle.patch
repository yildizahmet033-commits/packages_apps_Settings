From df15f94cd1a9b9b76c5aa6c1774fbf3812182ed5 Mon Sep 17 00:00:00 2001
From: Ahmet033 <261602157+yildizahmet033-commits@users.noreply.github.com>
Date: Tue, 24 Nov 2026 00:24:24 +0300
Subject: [PATCH] SettingsGoogle: Add screen saturation slider and resolution
 selector

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0162zUP5ing4joHDwXBhLEKM
---
 AndroidManifest.xml          | 11 +++++++++++
 res/xml/display_settings.xml | 18 ++++++++++++++++++
 2 files changed, 29 insertions(+)

diff --git a/AndroidManifest.xml b/AndroidManifest.xml
index 06cd8c4..8592d69 100644
--- a/AndroidManifest.xml
+++ b/AndroidManifest.xml
@@ -12,6 +12,17 @@
 
         <uses-library android:name="org.apache.http.legacy" />
 
+        <!-- Screen saturation -->
+        <receiver
+            android:name="org.evolution.settings.display.saturation.ScreenSaturationReceiver"
+            android:exported="false"
+            android:directBootAware="true">
+            <intent-filter>
+                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
+                <action android:name="android.intent.action.BOOT_COMPLETED" />
+            </intent-filter>
+        </receiver>
+
         <!-- Locale Picker -->
         <activity
             android:name="com.google.android.settings.localepicker.SetupSystemLocalePickerActivity"
diff --git a/res/xml/display_settings.xml b/res/xml/display_settings.xml
index a32de45..6f6670c 100644
--- a/res/xml/display_settings.xml
+++ b/res/xml/display_settings.xml
@@ -183,6 +183,18 @@
             settings:controller="com.android.settings.display.ColorModePreferenceController"
             settings:keywords="@string/keywords_color_mode"/>
 
+        <org.evolution.settings.preferences.CustomSeekBarPreference
+            android:key="screen_saturation"
+            android:title="@string/screen_saturation_title"
+            android:persistent="false"
+            android:defaultValue="200"
+            android:max="200"
+            settings:min="100"
+            settings:interval="5"
+            settings:units="%"
+            settings:continuousUpdates="true"
+            settings:controller="org.evolution.settings.display.saturation.ScreenSaturationPreferenceController" />
+
         <lineageos.preference.LineagePartsPreference
             android:key="live_display_color_profile"
             settings:replacesKey="color_mode"
@@ -238,6 +250,12 @@
             settings:keywords="@string/keywords_screen_resolution"
             settings:controller="com.android.settings.display.ScreenResolutionController"/>
 
+        <ListPreference
+            android:key="display_resolution"
+            android:title="@string/display_resolution_title"
+            android:persistent="false"
+            settings:controller="org.evolution.settings.display.resolution.DisplayResolutionPreferenceController" />
+
         <Preference
             android:key="screen_refresh_rate"
             android:title="@string/screen_refresh_rate_title"
-- 
2.56.1

